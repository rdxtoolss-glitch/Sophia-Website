# Prioritize index.html over index.php so static site takes effect immediately
DirectoryIndex index.html index.php

# Prevent aggressive caching during Google OAuth verification
<IfModule LiteSpeed>
    CacheDisable
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</IfModule>
